# ── SendPilot environment ──────────────────────────────────────────────
# Copy to .env and adjust. NEVER commit a real .env.

# Core
ENV=local
LOG_LEVEL=INFO

# Database. The APP connects as a NON-superuser role (RLS is enforced); Alembic
# connects as the owner (postgres) to create extensions/types/tables/policies.
DATABASE_URL=postgresql+asyncpg://sendpilot_app:sendpilot_app@db:5432/sendpilot
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@db:5432/sendpilot

# Redis (arq queue + rate-limit buckets + OAuth state)
REDIS_URL=redis://redis:6379/0

# Anthropic (extraction). Leave blank locally — the tabular path needs no key,
# and tests use a fake client. Set to run the live narrative path.
ANTHROPIC_API_KEY=

# KMS / envelope encryption.
#   local:<name>  -> in-process LocalKMS (dev). Requires KMS_MASTER_KEY.
#   arn:aws:kms:… -> CloudKMS (prod, not wired in v1 scaffold).
KMS_KEY_ID=local:dev
# 32-byte base64 master key for LocalKMS (dev only). Generate your OWN — do not
# reuse anyone else's; this key encrypts your OAuth tokens at rest:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
KMS_MASTER_KEY=

# Object storage (S3-compatible; MinIO locally)
OBJECT_STORAGE_BUCKET=sendpilot-docs
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1

# Google OAuth (Gmail). With MOCK_PROVIDER=true these are unused and the
# mock-provider stands in for Google's auth/token endpoints.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/connections/google/callback

# Microsoft 365 OAuth (M2)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/v1/connections/microsoft/callback

# Local-dev mock provider (fake OAuth + send sandbox + webhook emitter)
MOCK_PROVIDER=true
MOCK_PROVIDER_URL=http://mock-provider:9100          # internal (server-to-server)
MOCK_PROVIDER_PUBLIC_URL=http://localhost:9100       # browser-facing

# Sessions (BFF cookie signing)
SESSION_SECRET=dev-session-secret-change-me

# Web app base URL (OAuth post-connect redirect target)
WEB_BASE_URL=http://localhost:3000

# Document retention (days) for the purge job
DOC_RETENTION_DAYS=30

# Calendly personal access token (bookings/ pipeline only — booking sync).
# Get a free one: calendly.com -> Integrations -> API & webhooks. Leave blank if unused.
CALENDLY_PAT=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
